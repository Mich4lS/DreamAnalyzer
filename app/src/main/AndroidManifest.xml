<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="user.example.dreamanalyzer">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Główna definicja aplikacji -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DreamAnalyzer"
        tools:targetApi="31">

        <!-- Aktywność główna (strona startowa) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DreamAnalyzer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Aktywność: Ekran "Opowiedz mi swój sen" -->
        <activity
            android:name=".AddDreamActivity"
            android:exported="true"
            android:label="Opowiedz swój sen"
            android:theme="@style/Theme.DreamAnalyzer" />

        <!-- Aktywność: Kalendarz snów -->
        <activity
            android:name=".CalendarActivity"
            android:exported="true"
            android:label="Lista twoich snów"
            android:theme="@style/Theme.DreamAnalyzer" />

        <!-- Aktywność: Statystyki -->
        <activity
            android:name=".StatsActivity"
            android:exported="true"
            android:label="Statystyki"
            android:theme="@style/Theme.DreamAnalyzer" />

        <!-- Aktywność: Ciekawostki -->
        <activity
            android:name=".TipsActivity"
            android:exported="true"
            android:label="Ciekawostki"
            android:theme="@style/Theme.DreamAnalyzer" />

        <activity android:name=".DreamDetailActivity" />


    </application>

</manifest>


